# Copy to .env for local development (make docker-up / make run / make
# migrate-up all load this file — see Makefile). Never commit the real
# .env; production values live in the VPS's environment, injected at
# deploy time, not in this repo.

APP_ENV=development
LOG_LEVEL=debug

# --- Server ---
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=15s
# Comma-separated list of origins allowed to call the API with credentials.
SERVER_ALLOWED_ORIGINS=http://localhost:3000

# --- Postgres ---
# Values below match deployments/compose/docker-compose.yml's postgres service.
POSTGRES_HOST=localhost
# 5433, not Postgres's default 5432 — avoids clashing with a Postgres
# already installed outside Docker on the dev machine (see
# deployments/compose/docker-compose.yml).
POSTGRES_PORT=5433
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=fashion_store
POSTGRES_SSLMODE=disable

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Sessions ---
SESSION_COOKIE_NAME=sid
SESSION_TTL=168h
# Set to false only for local http (non-TLS) development.
SESSION_COOKIE_SECURE=false

# --- MinIO / object storage ---
# Values below match deployments/compose/docker-compose.yml's minio service.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fashion-store
MINIO_USE_SSL=false

# --- M-Pesa (Daraja API) ---
# Optional until the payment module is implemented — see docs/spec.md §8.
# Sandbox credentials: https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS base URL Safaricom will call back to, e.g. https://api.example.com
MPESA_CALLBACK_BASE_URL=

# --- Stripe ---
# Optional until the payment module is implemented — see docs/spec.md §8.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Worker ---
WORKER_HEALTH_PORT=8081
